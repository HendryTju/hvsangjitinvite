---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sangjit - Hendry & Valensia">
  <!-- Floating Navigation -->
  <div class="fixed top-6 right-6 lg:top-12 lg:right-12 z-50 mix-blend-difference flex gap-2">
    <a href="#hero">
      <button class="rounded-full inline-flex items-center justify-center text-xs lg:text-sm uppercase tracking-widest text-primary font-black hover:bg-primary hover:text-secondary h-8 px-4 lg:h-10 lg:px-6 transition-all duration-300">
        Hero
      </button>
    </a>
    <a href="#details">
      <button class="rounded-full inline-flex items-center justify-center text-xs lg:text-sm uppercase tracking-widest text-primary font-black hover:bg-primary hover:text-secondary h-8 px-4 lg:h-10 lg:px-6 transition-all duration-300">
        Details
      </button>
    </a>
  </div>

  <main class="w-full flex flex-col font-sans text-center md:text-start">
    
    <!-- HERO SECTION -->
    <section id="hero" class="relative min-h-screen w-full bg-dark flex flex-col items-center justify-center p-8 lg:p-20 overflow-hidden">
      <!-- Full Background Image -->
      <img src="/sangjit-couple.jpg" class="absolute inset-0 w-full h-full object-cover opacity-40" alt="Sangjit couple">

      <div class="z-10 flex flex-col items-center text-center max-w-5xl mx-auto space-y-12">
        <div class="text-7xl md:text-9xl text-primary/30 font-serif leading-none mb-4 mix-blend-difference">囍</div>
        <p class="text-xs md:text-lg font-bold uppercase tracking-[5px] text-primary/80">You Are Invited To The Sangjit Of</p>
        
        <h1 class="text-5xl md:text-8xl lg:text-[8rem] font-black uppercase tracking-widest text-primary leading-none mix-blend-difference">
          Valensia &amp; Hendry
        </h1>
        
        <p class="text-lg md:text-3xl font-bold uppercase tracking-[4px] text-primary mt-4 mix-blend-difference">
          Saturday, 28 Nov 2026
        </p>

        <p class="text-xs md:text-sm font-semibold tracking-widest mt-12 max-w-lg mx-auto text-primary/70 leading-relaxed uppercase">
          Please join us in celebrating the traditional engagement ceremony between our families
        </p>
        
        <div class="mt-16 w-full max-w-4xl border-t-2 border-primary/20 pt-12 flex flex-col md:flex-row items-center justify-center md:justify-between gap-8 text-primary">
          <div class="flex flex-col items-center text-center flex-1">
            <h2 class="font-serif text-3xl md:text-5xl italic font-bold">Valensia</h2>
            <p class="text-[10px] md:text-xs font-semibold uppercase tracking-[3px] mt-4 opacity-70">Daughter of Mr. Bong Ket Hau<br>&amp; Mrs. Liauw Su San</p>
          </div>
          <div class="hidden md:block h-24 w-[1.5px] bg-primary/20"></div>
          <div class="md:hidden w-24 h-[1.5px] bg-primary/20 my-4"></div>
          <div class="flex flex-col items-center text-center flex-1">
            <h2 class="font-serif text-3xl md:text-5xl italic font-bold">Hendry</h2>
            <p class="text-[10px] md:text-xs font-semibold uppercase tracking-[3px] mt-4 opacity-70">Son of Mr. Tju Sjin Tjhong<br>&amp; Mrs. Susana</p>
          </div>
        </div>
      </div>
      
      <a class="absolute bottom-10 animate-bounce" href="#details">
        <div class="w-8 h-12 border-2 border-primary rounded-full flex justify-center p-2 mix-blend-difference">
          <div class="w-1 h-2 bg-primary rounded-full"></div>
        </div>
      </a>
    </section>

    <!-- DETAILS SECTION -->
    <section id="details" class="relative min-h-screen w-full bg-light text-dark flex flex-col items-center justify-center p-8 lg:p-20 py-32 overflow-hidden">
      <div class="z-10 flex flex-col items-center text-center max-w-5xl mx-auto w-full">
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-black uppercase tracking-[5px] mb-16">The Ceremony</h2>
        
        <div class="flex flex-col w-full items-center gap-6">
          
          <!-- Accordion: Sangjit -->
          <details class="group w-full max-w-3xl border-[1.5px] border-dark rounded-[40px] overflow-hidden bg-light transition-all open:bg-red-100">
            <summary class="flex justify-between items-center cursor-pointer p-8 md:p-10 outline-none select-none">
              <h3 class="text-xl md:text-3xl font-black uppercase tracking-[3px]">Sangjit &amp; Lunch</h3>
              <span class="text-3xl font-light transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="p-8 md:p-10 pt-0 text-left border-t-[1.5px] border-dark/10">
              <div class="text-base md:text-xl font-medium tracking-widest space-y-4 uppercase">
                <p class="opacity-70">11.00 - 14.00 WIB</p>
                <p class="font-black text-2xl">A Hwa Signature PIK, LT 2.</p>
                <p class="text-sm font-bold opacity-60">JL SIMPANG EMPAT 4, RECA 09-16, Jl. Pantai Indah Kapuk, Riverwalk Island, Jkt Utara, DKI Jakarta 14460</p>
                
                <div class="pt-6 flex flex-col sm:flex-row gap-4">
                  <a href="https://share.google/2qoK3I0HHoC7USozb" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border-2 border-dark bg-dark text-light px-8 py-4 rounded-full text-sm font-black tracking-widest uppercase hover:bg-transparent hover:text-dark transition-colors">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                    View Map
                  </a>
                  <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Valensia+%26+Hendry+Sangjit&dates=20261128T040000Z/20261128T070000Z&details=Join+us+for+Valensia+and+Hendry's+Sangjit+Ceremony&location=Ahwa+PIK+Signature%2C+JL+SIMPANG+EMPAT+4%2C+RECA+09-16%2C+Jl.+Pantai+Indah+Kapuk%2C+Riverwalk+Island%2C+Jkt+Utara%2C+DKI+Jakarta+14460%2C+Indonesia" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 border-2 border-dark bg-transparent text-dark px-8 py-4 rounded-full text-sm font-black tracking-widest uppercase hover:bg-dark hover:text-light transition-colors">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zm-7 5h5v5h-5z"/></svg>
                    Add to Google Calendar
                  </a>
                </div>
              </div>
            </div>
          </details>

          <!-- Accordion: Dress Code -->
          <details class="group w-full max-w-3xl border-[1.5px] border-dark rounded-[40px] overflow-hidden bg-light transition-all open:bg-red-100">
            <summary class="flex justify-between items-center cursor-pointer p-8 md:p-10 outline-none select-none">
              <h3 class="text-xl md:text-3xl font-black uppercase tracking-[3px]">Dress Code</h3>
              <span class="text-3xl font-light transition-transform group-open:rotate-45">+</span>
            </summary>
            <div class="p-8 md:p-10 pt-0 text-left border-t-[1.5px] border-dark/10">
              <div class="text-base md:text-xl font-medium tracking-widest space-y-4 uppercase">
                <p class="font-black text-2xl">Color Guide</p>
                
                <div class="flex flex-wrap gap-6 pt-2">
                  <div class="flex flex-col items-center gap-2">
                    <div class="w-12 h-12 rounded-full bg-red-600 border-[1.5px] border-dark/20 shadow-sm"></div>
                    <span class="text-[10px] font-bold opacity-70">Red</span>
                  </div>
                  <div class="flex flex-col items-center gap-2">
                    <div class="w-12 h-12 rounded-full bg-[#800000] border-[1.5px] border-dark/20 shadow-sm"></div>
                    <span class="text-[10px] font-bold opacity-70">Maroon</span>
                  </div>
                  <div class="flex flex-col items-center gap-2">
                    <div class="w-12 h-12 rounded-full bg-pink-400 border-[1.5px] border-dark/20 shadow-sm"></div>
                    <span class="text-[10px] font-bold opacity-70">Pink</span>
                  </div>
                  <div class="flex flex-col items-center gap-2">
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-orange-400 via-yellow-400 to-rose-400 border-[1.5px] border-dark/20 shadow-sm"></div>
                    <span class="text-[10px] font-bold opacity-70 text-center">Bright<br>Colors</span>
                  </div>
                </div>

                <div class="pt-6 text-sm font-bold opacity-80 space-y-3 normal-case tracking-normal">
                  <p class="flex items-start gap-3">
                    <span class="text-red-600 font-black mt-0.5">✕</span> 
                    <span>Avoid dark colors and white.</span>
                  </p>
                  <p class="flex items-start gap-3">
                    <span class="text-green-600 font-black mt-0.5">✓</span> 
                    <span>Suggestion: red, maroon, pink, and other bright colors.</span>
                  </p>
                </div>

              </div>
            </div>
          </details>

        </div>

        <div class="mt-32 flex flex-col items-center gap-6 opacity-60">
          <div class="text-4xl font-serif">囍</div>
          <div class="text-sm md:text-lg font-bold uppercase tracking-[3px] max-w-3xl w-full leading-relaxed mt-4">
            <p class="mb-8">
              We look forward to sharing this joy with you.<br><br>
              Cordially yours,
            </p>
            <div class="flex flex-col md:flex-row justify-center items-center md:items-start gap-8 md:gap-16 w-full">
              <p class="flex-1 text-center md:text-right">
                The family of<br>Mr. Bong Ket Hau &amp;<br>Mrs. Liauw Su San
              </p>
              <p class="flex-1 text-center md:text-left">
                The family of<br>Mr. Tju Sjin Tjhong &amp;<br>Mrs. Susana
              </p>
            </div>
          </div>
          <div class="text-3xl font-black tracking-widest mt-8">VH</div>
        </div>
      </div>
    </section>

    <!-- RSVP SECTION -->
    <section id="rsvp" class="relative min-h-screen w-full bg-[#8c1c13] text-[#f4ebd0] flex flex-col items-center justify-center p-8 lg:p-20 overflow-hidden font-sans">
      <div class="z-10 flex flex-col items-center max-w-2xl mx-auto w-full">
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-medium tracking-widest mb-6 uppercase">RSVP</h2>
        <p class="text-xs md:text-sm font-bold uppercase tracking-[4px] mb-12 opacity-90 text-center">
          We would love for you to join us
        </p>

        <!-- Form State -->
        <form id="rsvp-form" class="w-full flex flex-col gap-8 text-[#8c1c13]">
          <!-- Name -->
          <div class="flex flex-col gap-2 text-left">
            <label class="text-xs font-bold uppercase tracking-widest text-[#f4ebd0]" for="guest-name">Full Name</label>
            <input type="text" id="guest-name" name="name" required class="w-full p-4 rounded-xl bg-[#f4ebd0] border-none outline-none focus:ring-2 ring-[#e2b144] text-base placeholder-[#8c1c13]/50 font-medium" placeholder="Your Name">
          </div>

          <!-- Pax -->
          <div class="flex flex-col gap-2 text-left">
            <label class="text-xs font-bold uppercase tracking-widest text-[#f4ebd0]" for="guest-pax">Number of Guests</label>
            <select id="guest-pax" name="pax" required class="w-full p-4 rounded-xl bg-[#f4ebd0] border-none outline-none focus:ring-2 ring-[#e2b144] text-base font-medium appearance-none" style="background-image: url('data:image/svg+xml;utf8,<svg fill=\'%238c1c13\' height=\'24\' viewBox=\'0 0 24 24\' width=\'24\' xmlns=\'http://www.w3.org/2000/svg\'><path d=\'M7 10l5 5 5-5z\'/></svg>'); background-repeat: no-repeat; background-position-x: 98%; background-position-y: 50%;">
              <option value="1">1 Person</option>
              <option value="2">2 Persons</option>
              <option value="3">3 Persons</option>
              <option value="4">4 Persons</option>
              <option value="5">5 Persons</option>
            </select>
          </div>

          <!-- Diet -->
          <div class="flex flex-col gap-2 text-left">
            <label class="text-xs font-bold uppercase tracking-widest text-[#f4ebd0]" for="guest-diet">Dietary Restrictions</label>
            <textarea id="guest-diet" name="diet" rows="2" class="w-full p-4 rounded-xl bg-[#f4ebd0] border-none outline-none focus:ring-2 ring-[#e2b144] text-base placeholder-[#8c1c13]/50 font-medium resize-y" placeholder="None"></textarea>
          </div>

          <button type="submit" id="rsvp-submit-btn" class="mt-4 bg-[#e2b144] text-[#8c1c13] font-bold uppercase tracking-[4px] py-5 px-8 rounded-full hover:bg-[#d4a033] transition-colors w-full text-sm">
            Submit RSVP
          </button>
        </form>

        <!-- Success State -->
        <div id="rsvp-success" class="hidden w-full flex-col items-center gap-8 text-center mt-8">
          <h3 class="font-serif italic text-4xl md:text-6xl text-[#e2b144] font-bold">Thank You!</h3>
          <p class="text-lg md:text-xl font-medium tracking-widest leading-loose text-[#f4ebd0]">
            Your RSVP has been saved.<br>We can't wait to celebrate with you!
          </p>

          <div class="w-full max-w-md h-[1px] bg-[#f4ebd0]/30 my-4"></div>

          <p class="text-sm font-bold uppercase tracking-widest mb-2 text-[#f4ebd0]">Save the Date</p>
          <a href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=Valensia+%26+Hendry+Sangjit&dates=20261128T040000Z/20261128T070000Z&details=Join+us+for+Valensia+and+Hendry's+Sangjit+Ceremony&location=Ahwa+PIK+Signature%2C+JL+SIMPANG+EMPAT+4%2C+RECA+09-16%2C+Jl.+Pantai+Indah+Kapuk%2C+Riverwalk+Island%2C+Jkt+Utara%2C+DKI+Jakarta+14460%2C+Indonesia" target="_blank" rel="noopener noreferrer" class="bg-[#e2b144] text-[#8c1c13] px-6 py-4 rounded-full font-bold uppercase tracking-widest hover:scale-105 transition-transform text-xs w-full max-w-sm flex items-center justify-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zm-7 5h5v5h-5z"/></svg>
            Add to Calendar
          </a>
        </div>
      </div>
    </section>

  </main>

  <script type="module">
    import { submitSangjitRsvp } from '/rsvp.js';

    const form = document.getElementById('rsvp-form');
    const successDiv = document.getElementById('rsvp-success');
    const submitBtn = document.getElementById('rsvp-submit-btn');

    if(form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        submitBtn.textContent = "Saving...";
        submitBtn.disabled = true;

        const formData = new FormData(form);
        const data = {
          name: formData.get('name'),
          pax: parseInt(formData.get('pax')),
          diet: formData.get('diet')
        };

        try {
          await submitSangjitRsvp(data);
          form.classList.add('hidden');
          successDiv.classList.remove('hidden');
          successDiv.classList.add('flex');
        } catch(err) {
          console.error(err);
          alert("Failed to submit RSVP. Please try again.");
          submitBtn.textContent = "Submit RSVP";
          submitBtn.disabled = false;
        }
      });
    }
  </script>
  
  <audio id="bg-audio" autoplay loop preload="auto">
    <source src="/sangjit-song.mp3" type="audio/mpeg">
  </audio>
  <button id="audio-toggle" class="fixed bottom-6 left-6 lg:bottom-12 lg:left-12 z-50 w-12 h-12 bg-dark rounded-full flex items-center justify-center text-primary shadow-lg hover:scale-110 transition-transform">
    <!-- SVG for unmuted -->
    <svg id="icon-unmuted" class="w-6 h-6 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
    <!-- SVG for muted -->
    <svg id="icon-muted" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
  </button>

  <script>
    const audioEl = document.getElementById('bg-audio');
    const audioBtn = document.getElementById('audio-toggle');
    const iconUnmuted = document.getElementById('icon-unmuted');
    const iconMuted = document.getElementById('icon-muted');

    const updateAudioIcon = () => {
      if (audioEl.paused) {
        iconUnmuted.classList.add('hidden');
        iconMuted.classList.remove('hidden');
      } else {
        iconUnmuted.classList.remove('hidden');
        iconMuted.classList.add('hidden');
      }
    };

    if (audioBtn && audioEl) {
      audioBtn.addEventListener('click', () => {
        if (audioEl.paused) {
          audioEl.play().catch(e => console.log('Audio play error', e));
        } else {
          audioEl.pause();
        }
        updateAudioIcon();
      });

      audioEl.addEventListener('play', updateAudioIcon);
      audioEl.addEventListener('pause', updateAudioIcon);
    }

    // Play audio on first user interaction to bypass autoplay restrictions
    const initAudio = () => {
      if (audioEl && audioEl.paused) {
        audioEl.play().catch(e => console.log('Audio autoplay blocked', e));
      }
      updateAudioIcon();
      // Remove listeners once played
      ['click', 'touchstart', 'scroll'].forEach(event => {
        document.removeEventListener(event, initAudio);
      });
    };
    
    // Attempt to play immediately (will likely be blocked by browser)
    audioEl.play().then(() => {
      updateAudioIcon();
    }).catch(e => {
      // If blocked, wait for user interaction
      ['click', 'touchstart', 'scroll'].forEach(event => {
        document.addEventListener(event, initAudio, { once: true });
      });
    });
  </script>
</Layout>
