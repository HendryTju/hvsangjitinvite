---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RSVP Admin - Sangjit">
  <main class="w-full min-h-screen bg-light text-dark flex flex-col p-8 lg:p-20 font-sans">
    <div class="max-w-6xl mx-auto w-full">
      <div class="flex justify-between items-center mb-12">
        <h1 class="text-3xl md:text-5xl font-black uppercase tracking-[3px]">RSVP Admin</h1>
        <div class="text-sm font-bold tracking-widest bg-dark text-light px-6 py-2 rounded-full">
          Total Pax: <span id="total-pax">0</span>
        </div>
      </div>

      <div class="overflow-x-auto border-2 border-dark rounded-xl bg-white">
        <table class="w-full text-left border-collapse min-w-[600px]">
          <thead class="bg-dark text-light text-xs uppercase tracking-widest">
            <tr>
              <th class="p-4 font-bold border-b border-dark">Date</th>
              <th class="p-4 font-bold border-b border-dark">Name</th>
              <th class="p-4 font-bold border-b border-dark text-center">Pax</th>
              <th class="p-4 font-bold border-b border-dark">Dietary Restrictions</th>
              <th class="p-4 font-bold border-b border-dark text-center">Confirmed</th>
            </tr>
          </thead>
          <tbody id="rsvp-table-body" class="text-sm font-medium">
            <tr>
              <td colspan="5" class="p-8 text-center text-dark/50 italic tracking-widest">Loading RSVPs...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <script type="module">
    import { getAllSangjitRsvps, toggleSangjitRsvpConfirm } from '/rsvp.js';

    const tbody = document.getElementById('rsvp-table-body');
    const totalPaxEl = document.getElementById('total-pax');

    async function loadRsvps() {
      try {
        const rsvps = await getAllSangjitRsvps();
        let totalPax = 0;
        
        if (rsvps.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-dark/50 italic tracking-widest">No RSVPs yet.</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        
        rsvps.forEach(rsvp => {
          totalPax += parseInt(rsvp.pax || 0);
          const date = new Date(rsvp.timestamp).toLocaleDateString('en-GB', { 
            day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
          });

          const tr = document.createElement('tr');
          tr.className = 'border-b border-dark/10 hover:bg-dark/5 transition-colors';
          
          tr.innerHTML = `
            <td class="p-4 opacity-70 text-xs">${date}</td>
            <td class="p-4 font-bold text-base capitalize">${rsvp.name || '-'}</td>
            <td class="p-4 text-center font-black">${rsvp.pax || 0}</td>
            <td class="p-4 opacity-80">${rsvp.diet || 'None'}</td>
            <td class="p-4 text-center">
              <button 
                class="toggle-btn w-6 h-6 rounded-full border-2 border-dark flex items-center justify-center transition-colors ${rsvp.confirmed ? 'bg-green-500 border-green-500 text-white' : 'bg-transparent text-transparent hover:bg-dark/10'}"
                data-id="${rsvp.id}"
                data-status="${rsvp.confirmed}"
              >
                ✓
              </button>
            </td>
          `;
          tbody.appendChild(tr);
        });

        totalPaxEl.textContent = totalPax;

        // Add toggle listeners
        document.querySelectorAll('.toggle-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const button = e.currentTarget;
            const id = button.getAttribute('data-id');
            const currentStatus = button.getAttribute('data-status') === 'true';
            
            button.style.opacity = '0.5';
            try {
              await toggleSangjitRsvpConfirm(id, currentStatus);
              // Reload
              await loadRsvps();
            } catch (err) {
              console.error(err);
              alert('Failed to update status');
              button.style.opacity = '1';
            }
          });
        });

      } catch (err) {
        console.error("Failed to load RSVPs:", err);
        tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center text-red-500 font-bold uppercase tracking-widest">Error loading data</td></tr>';
      }
    }

    loadRsvps();
  </script>
</Layout>
