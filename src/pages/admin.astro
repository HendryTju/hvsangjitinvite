---
import Layout from '../layouts/Layout.astro';
---

<Layout title="RSVP Admin - Sangjit">
  <main class="w-full min-h-screen bg-light text-dark flex flex-col p-8 lg:p-20 font-sans">
    <div class="max-w-[1400px] mx-auto w-full space-y-16">
      
      <!-- Main RSVP Table -->
      <div>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4 w-full">
          <h1 class="text-3xl md:text-5xl font-black uppercase tracking-[3px]">RSVP Admin</h1>
          <div class="flex flex-wrap items-center gap-4">
            <button id="btn-toggle-add" class="text-xs font-bold uppercase tracking-widest border-2 border-dark bg-dark text-light hover:bg-transparent hover:text-dark transition-colors px-6 py-3 rounded-full">
              + Add Guest
            </button>
            <div class="text-sm font-bold tracking-widest bg-dark text-light px-6 py-3 rounded-full">
              Confirmed Pax: <span id="total-pax">0</span>
            </div>
          </div>
        </div>

        <!-- Add Guest Form (Hidden by default) -->
        <form id="add-guest-form" class="hidden flex-wrap items-end gap-4 bg-white p-6 rounded-xl border-2 border-dark mb-8">
          <div class="flex flex-col gap-1 flex-1 min-w-[200px]">
            <label class="text-xs font-bold uppercase tracking-widest">Name</label>
            <input type="text" name="name" required class="border-b-2 border-dark/30 p-2 outline-none focus:border-dark font-medium bg-transparent" placeholder="Guest Name">
          </div>
          <div class="flex flex-col gap-1 w-24">
            <label class="text-xs font-bold uppercase tracking-widest">Pax</label>
            <input type="number" name="pax" required min="1" class="border-b-2 border-dark/30 p-2 outline-none focus:border-dark font-medium bg-transparent text-center" value="1">
          </div>
          <div class="flex flex-col gap-1 flex-1 min-w-[150px]">
            <label class="text-xs font-bold uppercase tracking-widest">Diet</label>
            <input type="text" name="diet" class="border-b-2 border-dark/30 p-2 outline-none focus:border-dark font-medium bg-transparent" placeholder="None">
          </div>
          <div class="flex flex-col gap-1 w-32">
            <label class="text-xs font-bold uppercase tracking-widest">Family Of</label>
            <select name="familyOf" class="border-b-2 border-dark/30 p-2 outline-none focus:border-dark font-medium bg-transparent cursor-pointer">
              <option value="">- Select -</option>
              <option value="Hendry">Hendry</option>
              <option value="Valensia">Valensia</option>
              <option value="Both">Both</option>
            </select>
          </div>
          <div class="flex flex-col gap-1 w-24">
            <label class="text-xs font-bold uppercase tracking-widest">Table No.</label>
            <input type="text" name="tableNumber" class="border-b-2 border-dark/30 p-2 outline-none focus:border-dark font-medium bg-transparent text-center" placeholder="e.g. 1">
          </div>
          <button type="submit" id="btn-submit-guest" class="bg-dark text-light font-bold uppercase tracking-widest px-6 py-2 rounded-full hover:opacity-80 transition-opacity h-[42px]">
            Save
          </button>
        </form>

        <div class="overflow-x-auto border-2 border-dark rounded-xl bg-white shadow-[4px_4px_0px_rgba(28,25,23,1)]">
          <table class="w-full text-left border-collapse min-w-[1100px]">
            <thead class="bg-dark text-light text-xs uppercase tracking-widest">
              <tr>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap">Date</th>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap">Name</th>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap text-center">Pax</th>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap">Diet</th>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap">Family Of</th>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap">Table No.</th>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap text-center">Confirmed</th>
                <th class="p-4 font-bold border-b border-dark whitespace-nowrap text-center">Actions</th>
              </tr>
            </thead>
            <tbody id="rsvp-table-body" class="text-sm font-medium">
              <tr>
                <td colspan="8" class="p-8 text-center text-dark/50 italic tracking-widest">Loading RSVPs...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Seating Chart / Tables View -->
      <div>
        <h2 class="text-2xl md:text-4xl font-black uppercase tracking-[3px] mb-8 border-t-2 border-dark pt-8">Seating Chart Data</h2>
        <div id="seating-chart-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          <div class="p-8 text-center text-dark/50 italic tracking-widest col-span-full">Loading Tables...</div>
        </div>
      </div>

    </div>
  </main>

  <script type="module">
    import { getAllSangjitRsvps, toggleSangjitRsvpConfirm, updateSangjitRsvpAdminFields, adminAddSangjitRsvp } from '/rsvp.js';

    const tbody = document.getElementById('rsvp-table-body');
    const totalPaxEl = document.getElementById('total-pax');
    const seatingChartContainer = document.getElementById('seating-chart-container');
    const addGuestForm = document.getElementById('add-guest-form');
    const btnToggleAdd = document.getElementById('btn-toggle-add');
    const btnSubmitGuest = document.getElementById('btn-submit-guest');

    btnToggleAdd.addEventListener('click', () => {
      addGuestForm.classList.toggle('hidden');
      addGuestForm.classList.toggle('flex');
    });

    addGuestForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnSubmitGuest.textContent = 'Saving...';
      btnSubmitGuest.disabled = true;

      const formData = new FormData(addGuestForm);
      const data = {
        name: formData.get('name'),
        pax: parseInt(formData.get('pax')),
        diet: formData.get('diet') || 'None',
        familyOf: formData.get('familyOf'),
        tableNumber: formData.get('tableNumber')
      };

      try {
        await adminAddSangjitRsvp(data);
        addGuestForm.reset();
        addGuestForm.classList.add('hidden');
        addGuestForm.classList.remove('flex');
        await loadRsvps();
      } catch (err) {
        console.error(err);
        alert('Failed to add guest');
      }

      btnSubmitGuest.textContent = 'Save';
      btnSubmitGuest.disabled = false;
    });

    // Debounce helper for inputs
    function debounce(func, wait) {
      let timeout;
      return function executedFunction(...args) {
        const later = () => {
          clearTimeout(timeout);
          func(...args);
        };
        clearTimeout(timeout);
        timeout = setTimeout(later, wait);
      };
    }

    async function loadRsvps(skipTableRender = false) {
      try {
        let rsvps = await getAllSangjitRsvps();
        // Filter out soft-deleted items
        rsvps = rsvps.filter(r => r.deleted !== true);

        let totalConfirmedPax = 0;
        
        if (rsvps.length === 0) {
          if (!skipTableRender) {
            tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-dark/50 italic tracking-widest">No RSVPs yet.</td></tr>';
          }
          seatingChartContainer.innerHTML = '<div class="p-8 text-center text-dark/50 italic tracking-widest col-span-full">No tables assigned.</div>';
          totalPaxEl.textContent = '0';
          return;
        }

        if (!skipTableRender) tbody.innerHTML = '';
        
        // Data for grouping tables
        const tables = {};

        rsvps.forEach(rsvp => {
          if (rsvp.confirmed) {
            totalConfirmedPax += parseInt(rsvp.pax || 0);
          }
          
          // Grouping logic for Seating Chart
          if (rsvp.tableNumber) {
            if (!tables[rsvp.tableNumber]) {
              tables[rsvp.tableNumber] = [];
            }
            tables[rsvp.tableNumber].push(rsvp);
          }

          if (!skipTableRender) {
            const date = new Date(rsvp.timestamp).toLocaleDateString('en-GB', { 
              day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
            });

            const tr = document.createElement('tr');
            tr.className = 'border-b border-dark/10 hover:bg-dark/5 transition-colors';
            
            const sourceBadge = rsvp.source === 'admin' 
              ? '<span class="text-[10px] bg-blue-100 text-blue-800 px-2 py-0.5 rounded ml-2 uppercase font-bold tracking-widest align-middle">Admin</span>'
              : '<span class="text-[10px] bg-gray-200 text-gray-700 px-2 py-0.5 rounded ml-2 uppercase font-bold tracking-widest align-middle">Form</span>';

            tr.innerHTML = `
              <td class="p-4 opacity-70 text-xs">${date}</td>
              <td class="p-4 font-bold text-base capitalize whitespace-nowrap">${rsvp.name || '-'}${sourceBadge}</td>
              <td class="p-4 text-center font-black">${rsvp.pax || 0}</td>
              <td class="p-4 opacity-80 max-w-[200px] truncate" title="${rsvp.diet || ''}">${rsvp.diet || 'None'}</td>
              <td class="p-4">
                <select class="field-family w-full bg-transparent border-b border-dark/30 outline-none pb-1 focus:border-dark font-medium" data-id="${rsvp.id}">
                  <option value="" ${!rsvp.familyOf ? 'selected' : ''}>- Select -</option>
                  <option value="Hendry" ${rsvp.familyOf === 'Hendry' ? 'selected' : ''}>Hendry</option>
                  <option value="Valensia" ${rsvp.familyOf === 'Valensia' ? 'selected' : ''}>Valensia</option>
                  <option value="Both" ${rsvp.familyOf === 'Both' ? 'selected' : ''}>Both</option>
                </select>
              </td>
              <td class="p-4">
                <input type="text" class="field-table w-20 bg-transparent border-b border-dark/30 outline-none pb-1 focus:border-dark font-black text-center" data-id="${rsvp.id}" value="${rsvp.tableNumber || ''}" placeholder="e.g. 1" />
              </td>
              <td class="p-4 text-center">
                <button 
                  class="toggle-btn w-6 h-6 rounded-full border-2 mx-auto border-dark flex items-center justify-center transition-colors ${rsvp.confirmed ? 'bg-green-500 border-green-500 text-white' : 'bg-transparent text-transparent hover:bg-dark/10'}"
                  data-id="${rsvp.id}"
                  data-status="${rsvp.confirmed}"
                >
                  ✓
                </button>
              </td>
              <td class="p-4 text-center">
                <button 
                  class="delete-btn w-8 h-8 rounded-full flex items-center justify-center text-red-500 hover:bg-red-50 transition-colors mx-auto"
                  data-id="${rsvp.id}"
                  title="Remove Guest"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
              </td>
            `;
            tbody.appendChild(tr);
          }
        });

        totalPaxEl.textContent = totalConfirmedPax;

        // Render Seating Chart
        renderSeatingChart(tables);

        // Attach Event Listeners
        if (!skipTableRender) {
          // Toggle Confirmed
          document.querySelectorAll('.toggle-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              const button = e.currentTarget;
              const id = button.getAttribute('data-id');
              const currentStatus = button.getAttribute('data-status') === 'true';
              
              button.style.opacity = '0.5';
              try {
                await toggleSangjitRsvpConfirm(id, currentStatus);
                await loadRsvps();
              } catch (err) {
                console.error(err);
                alert('Failed to update status');
                button.style.opacity = '1';
              }
            });
          });

          // Update Family Of
          document.querySelectorAll('.field-family').forEach(select => {
            select.addEventListener('change', async (e) => {
              const id = e.target.getAttribute('data-id');
              const familyOf = e.target.value;
              e.target.style.opacity = '0.5';
              try {
                await updateSangjitRsvpAdminFields(id, { familyOf });
              } catch (err) {
                console.error(err);
                alert('Failed to update family');
              }
              e.target.style.opacity = '1';
            });
          });

          // Update Table Number
          const handleTableChange = async (e) => {
            const id = e.target.getAttribute('data-id');
            const tableNumber = e.target.value;
            e.target.style.opacity = '0.5';
            try {
              await updateSangjitRsvpAdminFields(id, { tableNumber });
              // Reload only seating chart to prevent table jump/lag
              await loadRsvps(true);
            } catch (err) {
              console.error(err);
              alert('Failed to update table number');
            }
            e.target.style.opacity = '1';
          };

          document.querySelectorAll('.field-table').forEach(input => {
            input.addEventListener('change', handleTableChange);
          });

          // Soft Delete
          document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              if(!confirm('Are you sure you want to remove this guest?')) return;
              const button = e.currentTarget;
              const id = button.getAttribute('data-id');
              
              button.style.opacity = '0.5';
              try {
                // Soft delete by updating flag
                await updateSangjitRsvpAdminFields(id, { deleted: true });
                await loadRsvps();
              } catch (err) {
                console.error(err);
                alert('Failed to remove guest');
                button.style.opacity = '1';
              }
            });
          });
        }

      } catch (err) {
        console.error("Failed to load RSVPs:", err);
        tbody.innerHTML = '<tr><td colspan="8" class="p-8 text-center text-red-500 font-bold uppercase tracking-widest">Error loading data</td></tr>';
      }
    }

    function renderSeatingChart(tables) {
      seatingChartContainer.innerHTML = '';
      const tableKeys = Object.keys(tables).sort((a, b) => {
        // Try numerical sort first
        const numA = parseInt(a);
        const numB = parseInt(b);
        if (!isNaN(numA) && !isNaN(numB)) return numA - numB;
        return a.localeCompare(b);
      });

      if (tableKeys.length === 0) {
        seatingChartContainer.innerHTML = '<div class="p-8 text-center text-dark/50 italic tracking-widest col-span-full">No tables assigned yet.</div>';
        return;
      }

      tableKeys.forEach(tableNum => {
        const guests = tables[tableNum];
        let tableConfirmedPax = 0;
        
        const guestListHtml = guests.map(g => {
          if (g.confirmed) {
            tableConfirmedPax += parseInt(g.pax || 0);
          }
          
          const textClass = g.confirmed ? 'text-dark' : 'text-red-500 opacity-80';
          const badgeClass = g.confirmed ? 'bg-dark text-light' : 'bg-red-500 text-white';

          return `
            <div class="flex justify-between items-center py-2 border-b border-dark/10 last:border-0 text-sm ${textClass}">
              <span class="font-bold capitalize">${g.name}</span>
              <span class="text-xs px-2 py-1 rounded-full font-black ${badgeClass}">${g.pax} pax</span>
            </div>
          `;
        }).join('');

        const card = document.createElement('div');
        card.className = 'border-2 border-dark rounded-xl bg-white p-6 flex flex-col h-full shadow-[4px_4px_0px_rgba(28,25,23,1)]';
        card.innerHTML = `
          <div class="flex justify-between items-center mb-4 pb-4 border-b-2 border-dark">
            <h3 class="text-xl font-black uppercase tracking-widest">Table ${tableNum}</h3>
            <span class="text-xs font-bold uppercase tracking-wider text-dark/70">${tableConfirmedPax} Confirmed</span>
          </div>
          <div class="flex flex-col gap-1 flex-1">
            ${guestListHtml}
          </div>
        `;
        seatingChartContainer.appendChild(card);
      });
    }

    loadRsvps();
  </script>
</Layout>
